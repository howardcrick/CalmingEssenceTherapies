<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalmingEssenceTherapies.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalmingEssenceTherapies.App.Views"
    Title="CalmingEssenceTherapies.App">

    <ShellContent
        Title="Treatment Details"
        ContentTemplate="{DataTemplate local:TreatmentDetailsView}"
        Route="TreatmentDetailsView" />

    <ShellContent
        Title="Add Treatment"
        ContentTemplate="{DataTemplate local:AddTreatmentView}"
        Route="AddTreatment" />

</Shell>

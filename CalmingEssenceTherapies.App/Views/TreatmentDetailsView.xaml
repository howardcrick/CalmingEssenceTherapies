<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:CalmingEssenceTherapies.App.ViewModels"
             x:Class="CalmingEssenceTherapies.App.Views.TreatmentDetailsView"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Title="Treatment Details"
             x:DataType="viewModels:TreatmentDetailsViewModel"
             x:Name="TreatmentDetails">
    <VerticalStackLayout>
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Margin="10">

            <Label Text="Name:"        Grid.Row="0" Margin="0,0,5,0" />
            <Label Text="Description:" Grid.Row="1" Margin="0,0,5,0" />
            <Label Text="Price:"       Grid.Row="2" Margin="0,0,5,0" />

            <Label Text="{Binding Name}"        Grid.Row="0" Grid.Column="1" />
            <Label Text="{Binding Description}" Grid.Row="1" Grid.Column="1" />
            <Label Text="{Binding Price, StringFormat='{0:C}'}"       
                                        Grid.Row="2" Grid.Column="1" />
        </Grid>
    </VerticalStackLayout>
</ContentPage>